<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        IIS ships WebDAV enabled by default. Its module and handler claim DELETE and PUT
        and answer them with 405 Method Not Allowed *before* the ASP.NET Core Module runs,
        which breaks DELETE /api/weight/{id} and DELETE /api/workouts/{id} in production.
        Neither the integration nor the Playwright tests can catch this: both run on
        Kestrel/TestServer and never go through IIS.
        Removing both is required — the handler and the module are registered separately.
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\WhatYouDid.exe" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
