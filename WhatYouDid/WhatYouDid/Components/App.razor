@using System.Reflection
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<base href="/" />
    <link rel="stylesheet" href="@Assets["bootstrap/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WhatYouDid.styles.css"]" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Press+Start+2P&display=swap" rel="stylesheet" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link href="@Assets["_content/CodeBeam.MudBlazor.Extensions/MudExtensions.min.css"]" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon192x192.png" />
    <meta name="theme-color" content="#0D0D0D" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <div id="sw-update-banner" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;background:#0D0D0D;color:#F0F0F0;border-top:2px solid #39FF14;padding:12px 16px;align-items:center;justify-content:space-between;gap:12px;">
        <span>A new version is available.</span>
        <button onclick="window.location.reload()" style="background:#39FF14;color:#000;border:none;padding:6px 16px;border-radius:4px;cursor:pointer;font-weight:600;">Reload</button>
    </div>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js?v=@AppVersion');
            navigator.serviceWorker.addEventListener('message', event => {
                if (event.data?.type === 'SW_UPDATED') {
                    document.getElementById('sw-update-banner').style.display = 'flex';
                }
            });
        }
    </script>
    <script src="@Assets["cardswapper.js"]"></script>
    <script src="@Assets["wakelock.js"]"></script>
	<script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_content/CodeBeam.MudBlazor.Extensions/MudExtensions.min.js"]"></script>
</body>

</html>
@code {
    // Build id appended to the service-worker URL so each deploy registers a fresh worker,
    // whose activate handler evicts the previous build's cache and shows the update banner.
    //
    // The SDK suffixes InformationalVersion with the git commit ("1.0.0+a553432..."), so
    // this changes with every deployed commit - including client-only changes, which the
    // server assembly's ModuleVersionId would miss (the server compiles against the
    // client's reference assembly). Falls back to the MVID when built outside git.
    //
    // Correctness does not depend on this: assets are fingerprinted via @Assets[...] and
    // <ImportMap />, and the worker only serves fingerprinted URLs from cache.
    private static readonly string AppVersion = GetAppVersion();

    private static string GetAppVersion()
    {
        var assembly = typeof(App).Assembly;
        var informational = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        var plus = informational?.IndexOf('+') ?? -1;
        return plus >= 0 && informational!.Length > plus + 1
            ? informational[(plus + 1)..Math.Min(informational.Length, plus + 9)]
            : assembly.ManifestModule.ModuleVersionId.ToString("N")[..8];
    }
}
